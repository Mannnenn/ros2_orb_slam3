<launch>
    <node
        pkg="ros2_orb_slam3"
        exec="mono_node_cpp"
        name="mono_slam_cpp"
        output="screen">
        <param name="node_name_arg" value="mono_slam_cpp" />
        <remap from="/mono_py_driver/img_msg" to="/camera/camera/infra1/image_rect_raw" />
    </node>

    <node
        pkg="ros2_orb_slam3"
        exec="mono_my_cam.py"
        name="mono_my_cam"
        output="screen">
        <param name="settings_name" value="EuRoC" />
        <param name="image_seq" value="sample_euroc_MH05" />
    </node>
</launch>